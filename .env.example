# Neon pooled connection string used by CYBER//NET at runtime.
# Copy this file to .env and replace the placeholder locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional direct connection string for manual database migrations only.
# The app does not use this value for normal requests.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
